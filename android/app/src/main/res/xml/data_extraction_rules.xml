<?xml version="1.0" encoding="utf-8"?>
<!--
  Credentials are device-bound. Reconnect after restoring on another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/ts_config.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/ts_config.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
